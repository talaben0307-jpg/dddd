local function EquipWeapon(character)
    if not AutoEquipEnabled then return end
    if character:FindFirstChildOfClass("Tool") then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            local lowerName = string.lower(item.Name)
            if string.find(lowerName, "saber") or string.find(lowerName, "sword") or string.find(lowerName, "katana") or string.find(lowerName, "blade") then
                character:FindFirstChildOfClass("Humanoid"):EquipTool(item)
                return
            end
        end
    end
    local firstTool = backpack:FindFirstChildOfClass("Tool")
    if firstTool and character:FindFirstChildOfClass("Humanoid") then
        character:FindFirstChildOfClass("Humanoid"):EquipTool(firstTool)
    end
end

local function PerformM1()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    EquipWeapon(character)

    local equippedTool = character:FindFirstChildOfClass("Tool")
    if equippedTool then
        pcall(function()
            equippedTool:Activate()
        end)
    end

    pcall(function()
        local viewport = workspace.CurrentCamera.ViewportSize
        local x, y = viewport.X / 2, viewport.Y / 2
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

RunService.Heartbeat:Connect(function()
    if AutoM1Enabled and (tick() - LastAttack >= AttackDelay) then
        LastAttack = tick()
        PerformM1()
    end
end)
